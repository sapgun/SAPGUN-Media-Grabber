<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SapgunMediaGrabber.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, SF Pro Text, Noto Sans, sans-serif"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#0B0D12"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Background" Value="#141822"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.profile-card">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Background" Value="#141822"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Background" Value="#163528"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8ED7A7"/>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
  </Application.Styles>
</Application>
