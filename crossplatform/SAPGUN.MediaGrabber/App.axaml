<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SapgunMediaGrabber.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, SF Pro Text, Noto Sans, sans-serif"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.8"/>
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="54"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="LetterSpacing" Value="1.2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#0B0D12"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Background" Value="#141822"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.profile-card">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Background" Value="#141822"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Background" Value="#163528"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8ED7A7"/>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Expander">
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
  </Application.Styles>
</Application>
