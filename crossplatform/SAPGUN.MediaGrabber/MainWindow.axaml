<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SapgunMediaGrabber.MainWindow"
        Title="SAPGUN Media Grabber v0.3.0-alpha.2"
        Width="760" Height="980" MinWidth="680" MinHeight="800"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="12">
      <TextBlock x:Name="PlatformBanner" Text="LOCAL  •  yt-dlp + FFmpeg" FontSize="12" Foreground="#7EA4FF" FontWeight="Bold"/>
      <TextBlock Text="SAPGUN Media Grabber" FontSize="30" FontWeight="Bold"/>
      <TextBlock Text="Paste a URL. Pick a profile. Download locally." Opacity="0.72"/>

      <TextBlock Text="MEDIA URL" Margin="0,10,0,0" FontWeight="Bold"/>
      <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
        <TextBox x:Name="UrlBox" Grid.Column="0" PlaceholderText="https://..."/>
        <Button Grid.Column="1" Content="Paste" Click="Paste_Click" HorizontalContentAlignment="Center"/>
      </Grid>

      <TextBlock Text="OUTPUT PROFILE" Margin="0,10,0,0" FontWeight="Bold"/>
      <StackPanel Spacing="7">
        <RadioButton x:Name="XProfile" GroupName="profile" IsChecked="True" Content="X / Twitter 1080p — H.264 + AAC, upload-safe"/>
        <RadioButton x:Name="OriginalProfile" GroupName="profile" Content="Original Best — highest available quality"/>
        <RadioButton x:Name="Mp4Profile" GroupName="profile" Content="1080p MP4 — quick MP4 download / merge"/>
        <RadioButton x:Name="Mp3Profile" GroupName="profile" Content="Audio MP3 — high quality extraction"/>
      </StackPanel>

      <TextBlock Text="BROWSER COOKIES" Margin="0,10,0,0" FontWeight="Bold"/>
      <ComboBox x:Name="CookieBox"/>
      <TextBlock x:Name="CookieHint" Text="403 / sign-in errors? Pick the browser where you are already signed in." FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>

      <CheckBox x:Name="TrimCheck" Content="Trim / download a section" Margin="0,8,0,0"/>
      <Grid ColumnDefinitions="*,40,*" ColumnSpacing="4">
        <TextBox x:Name="TrimStart" Grid.Column="0" Text="00:00"/>
        <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="TrimEnd" Grid.Column="2" PlaceholderText="end, e.g. 01:15"/>
      </Grid>

      <TextBlock Text="SAVE TO" Margin="0,10,0,0" FontWeight="Bold"/>
      <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
        <TextBox x:Name="FolderBox" Grid.Column="0" IsReadOnly="True"/>
        <Button Grid.Column="1" Content="Browse" Click="Browse_Click" HorizontalContentAlignment="Center"/>
      </Grid>

      <Grid ColumnDefinitions="*,120" ColumnSpacing="8" Margin="0,10,0,0">
        <Button x:Name="DownloadButton" Grid.Column="0" Content="DOWNLOAD" Height="50" Background="#4C6FFF" Foreground="White" FontWeight="Bold" Click="Download_Click"/>
        <Button x:Name="CancelJobButton" Grid.Column="1" Content="Cancel" Height="50" IsEnabled="False" Click="CancelJob_Click"/>
      </Grid>
      <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="12"/>
      <TextBlock x:Name="StatusText" Text="Ready" FontWeight="Bold" Foreground="#8ED7A7"/>
      <TextBlock x:Name="ProgressText" Text="Waiting for a download." FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
      <Button x:Name="OpenFolderButton" Content="Open Output Folder" IsEnabled="False" Click="OpenFolder_Click"/>

      <Border BorderBrush="#4C6FFF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="APP" FontWeight="Bold" Foreground="#7EA4FF"/>
          <TextBlock Text="SAPGUN Media Grabber" FontWeight="Bold"/>
          <TextBlock x:Name="AppCurrentVersion" Text="Current: …" FontSize="12"/>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Channel" VerticalAlignment="Center" FontSize="12"/>
            <ComboBox x:Name="UpdateChannelBox" Grid.Column="1" SelectedIndex="0">
              <ComboBoxItem Content="Prerelease"/>
              <ComboBoxItem Content="Stable"/>
            </ComboBox>
          </Grid>
          <TextBlock x:Name="AppLatestVersion" Text="Latest: not checked yet" FontSize="12"/>
          <TextBlock x:Name="AppUpdateStatus" Text="App updates are separate from yt-dlp updates. Nothing is installed automatically." FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
          <ProgressBar x:Name="AppUpdateProgress" Minimum="0" Maximum="100" Height="10" IsVisible="False"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="CheckAppUpdateButton" Grid.Column="0" Content="Check App Update" Click="CheckAppUpdate_Click"/>
            <Button x:Name="DownloadAppUpdateButton" Grid.Column="1" Content="Download Update" IsEnabled="False" Click="DownloadAppUpdate_Click"/>
          </Grid>
          <Button x:Name="CancelAppUpdateButton" Content="Cancel download" IsVisible="False" Click="CancelAppUpdate_Click"/>
        </StackPanel>
      </Border>

      <Border BorderBrush="#404652" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="ENGINE" FontWeight="Bold"/>
          <TextBlock Text="yt-dlp" FontWeight="Bold"/>
          <Grid ColumnDefinitions="*,*">
            <TextBlock x:Name="InstalledYtDlp" Grid.Column="0" Text="Current: checking..." FontSize="12"/>
            <TextBlock x:Name="LatestYtDlp" Grid.Column="1" Text="Latest: checking..." HorizontalAlignment="Right" FontSize="12"/>
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Content="Check" Click="CheckYtDlp_Click"/>
            <Button Grid.Column="1" Content="Update yt-dlp" Click="UpdateYtDlp_Click"/>
            <Button Grid.Column="2" Content="How to use" Click="Help_Click"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="SUPPORT" Margin="0,8,0,0" FontWeight="Bold"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
        <Button Grid.Column="0" Content="★ Star on GitHub" Click="Star_Click"/>
        <Button Grid.Column="1" Content="Support me · Ko-fi" Click="Support_Click"/>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
        <Button x:Name="ThemeButton" Grid.Column="0" Content="Light mode" Click="Theme_Click"/>
        <Button Grid.Column="1" Content="Feedback / DM on X" Click="Feedback_Click"/>
      </Grid>

      <TextBlock Text="Cross-platform preview • local processing only" HorizontalAlignment="Center" Opacity="0.55" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
